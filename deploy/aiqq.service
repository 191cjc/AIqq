[Unit]
Description=AiQQ Bot Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/AiQQ
Environment=PYTHONUNBUFFERED=1
Environment=AIQQ_LOG_FILE=/var/lib/aiqq/aiqq.log
ExecStart=/home/ubuntu/AiQQ/.venv/bin/python -m aiqq.main
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/aiqq
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
UMask=0077

[Install]
WantedBy=multi-user.target
