# 在 QQ 开放平台的机器人“开发设置”中获取。
QQ_BOT_APPID=
QQ_BOT_SECRET=
AIQQ_QQ_HTTP_TIMEOUT_SECONDS=30

# 健康检查只监听本机，由 Nginx 提供 HTTPS 访问。
AIQQ_HEALTH_HOST=127.0.0.1
AIQQ_HEALTH_PORT=8787

# GPT Responses API。密钥需与你使用的代理服务匹配。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.airoo.cc/v1
OPENAI_MODEL=gpt-5.6-sol
OPENAI_TIMEOUT_SECONDS=180
AIQQ_AI_TOTAL_TIMEOUT_SECONDS=270
OPENAI_MAX_OUTPUT_TOKENS=1000
AIQQ_MAX_REPLY_CHARS=1800
AIQQ_MAX_CONCURRENT_AI=3
AIQQ_WEB_SEARCH_ENABLED=true
OPENAI_SUMMARY_MAX_OUTPUT_TOKENS=600

# 对话记忆按“群 + 用户”隔离，每 10 轮自动压缩为累计摘要。
AIQQ_MEMORY_DB=/var/lib/aiqq/memory.db
AIQQ_SUMMARY_EVERY_ROUNDS=10

# NovelAI 文生图 MCP。Token 与 Token 文件二选一，均不得提交到 Git。
NOVELAI_MCP_URL=
NOVELAI_MCP_TOKEN=
NOVELAI_MCP_TOKEN_FILE=
AIQQ_NOVELAI_TIMEOUT_SECONDS=240
AIQQ_NOVELAI_MAX_CONCURRENT=1
AIQQ_NOVELAI_USER_DAILY_LIMIT=100

# QQ 会通过这个临时 HTTPS 地址拉取生成结果。
AIQQ_MEDIA_DIR=/var/lib/aiqq/media
AIQQ_MEDIA_TTL_SECONDS=900
AIQQ_PUBLIC_BASE_URL=https://你的域名/aiqq

# 可选：不填写时使用项目内置的中文群聊助手提示词。
OPENAI_SYSTEM_PROMPT=
