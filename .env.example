# 在 QQ 开放平台的机器人“开发设置”中获取。
QQ_BOT_APPID=
QQ_BOT_SECRET=
AIQQ_QQ_HTTP_TIMEOUT_SECONDS=30
# 全量群消息独立持久化数据库。需要群管理员在机器人资料页开启“接收所有消息”。
AIQQ_GROUP_MESSAGE_DB=/var/lib/aiqq/group_messages.db
# 群消息查看页使用 HTTPS Basic Auth；生产环境必须设置高强度口令。
AIQQ_GROUP_MESSAGE_VIEW_USERNAME=admin
AIQQ_GROUP_MESSAGE_VIEW_PASSWORD=
# 每轮对话固定读取此前最多 50 条消息；参考资料正文总计默认最多 1000 字。
AIQQ_GROUP_HISTORY_MAX_MESSAGES=50
AIQQ_GROUP_HISTORY_MAX_CHARS=1000
# 图生图时交给 AI 匹配的当前群图片记录数，按图片消息从新到旧读取。
AIQQ_GROUP_REFERENCE_IMAGE_LIMIT=50
# QQ 网关连续断线超过此时间后，由 systemd 重启机器人。
AIQQ_GATEWAY_RESTART_TIMEOUT_SECONDS=90
# 应用结构化事件日志；保留天数需覆盖 7 天裁剪统计窗口。
AIQQ_LOG_FILE=/var/lib/aiqq/aiqq.log
AIQQ_LOG_BACKUP_DAYS=14

# 健康检查只监听本机，由 Nginx 提供 HTTPS 访问；网关断线时返回 503。
AIQQ_HEALTH_HOST=127.0.0.1
AIQQ_HEALTH_PORT=8787
# 本机控制台发送接口的独立 Bearer Token；也可以改用权限为 0600 的 Token 文件。
AIQQ_ADMIN_TOKEN=
AIQQ_ADMIN_TOKEN_FILE=

# AI 对话默认通过官方 Codex Python SDK 接入代理。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.airoo.cc/v1
OPENAI_MODEL=gpt-5.6-sol
# Codex 慢回合/前台等待阈值；达到后转入进展页面，不中止 SDK 任务。
OPENAI_TIMEOUT_SECONDS=280
# 非 Codex 后端的前台等待阈值，也是 Codex 前台等待阈值的上限。
AIQQ_AI_TOTAL_TIMEOUT_SECONDS=290
AIQQ_AI_BACKEND=codex_sdk
# 留空时优先使用 npm 包随附的原生 Codex，避免 systemd 依赖 Node.js PATH。
AIQQ_CODEX_CLI=
AIQQ_CODEX_RUNTIME_DIR=/var/lib/aiqq/codex-runtime
AIQQ_CODEX_WORK_DIR=/var/lib/aiqq/codex-work
AIQQ_CODEX_REASONING_EFFORT=high
AIQQ_CODEX_UTILITY_REASONING_EFFORT=high
AIQQ_REPLY_SUMMARY_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=1000
# 其他需要分段的 QQ 回复的目标字符数。
AIQQ_MAX_REPLY_CHARS=3000
AIQQ_MAX_CONCURRENT_AI=3
AIQQ_WEB_SEARCH_ENABLED=true
# 允许普通联网对话额外检索并发送一张公开网页图片，不占用生图额度。
AIQQ_WEB_IMAGE_SEARCH_ENABLED=true
AIQQ_WEB_IMAGE_TIMEOUT_SECONDS=20
# 允许普通对话调用项目 skill 生成结构化 GPT 生图动作。
AIQQ_GPT_IMAGE_SKILL_ENABLED=true

# GPT 文生图。密钥和域名留空时复用上面的 OPENAI_API_KEY/OPENAI_BASE_URL。
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_BASE_URL=
OPENAI_IMAGE_MODEL=gpt-image-2
# Responses 驱动模型，需支持 image_generation（当前验证为 gpt-6-astra）。
OPENAI_IMAGE_DRIVER_MODEL=gpt-6-astra
OPENAI_IMAGE_TIMEOUT_SECONDS=240
OPENAI_IMAGE_DOWNLOAD_TIMEOUT_SECONDS=60

# 仅保存生图额度和 NovelAI 提示词按钮会话；普通对话上下文来自群历史。
AIQQ_STATE_DB=/var/lib/aiqq/state.db

# NovelAI 文生图 MCP。Token 与 Token 文件二选一，均不得提交到 Git。
NOVELAI_MCP_URL=
NOVELAI_MCP_TOKEN=
NOVELAI_MCP_TOKEN_FILE=
AIQQ_NOVELAI_TIMEOUT_SECONDS=240
AIQQ_NOVELAI_MAX_CONCURRENT=1

# Codex、GPT 和 NovelAI 共用每日额度及全局单任务锁。
AIQQ_IMAGE_USER_DAILY_LIMIT=100

# QQ 会通过这个临时 HTTPS 地址拉取生成结果。
AIQQ_MEDIA_DIR=/var/lib/aiqq/media
AIQQ_MEDIA_TTL_SECONDS=900
AIQQ_PUBLIC_BASE_URL=https://你的域名/aiqq

# 所有文本回复完整原文的临时复制页，默认保留 1 小时。
AIQQ_REPLY_DIR=/var/lib/aiqq/replies
AIQQ_REPLY_TTL_SECONDS=3600

# 可选：不填写时使用项目内置的中文 AI 猫娘女仆群聊助手提示词。
OPENAI_SYSTEM_PROMPT=
